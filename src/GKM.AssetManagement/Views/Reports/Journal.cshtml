@model List<GlJournalRow>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Depreciation GL journal";
    int year = ViewBag.Year, month = ViewBag.Month;
    var periods = (List<DepreciationRun>)ViewBag.Periods;
}
<div class="d-flex justify-content-between mb-3">
    <form method="get" class="d-flex gap-2">
        <select name="year" class="form-select" style="width:100px" onchange="this.form.submit()">@foreach (var y in periods.Select(p => p.Year).Distinct()) { <option value="@y" selected="@(y == year)">@y</option> }</select>
        <select name="month" class="form-select" style="width:140px" onchange="this.form.submit()">@for (var m = 1; m <= 12; m++) { <option value="@m" selected="@(m == month)">@(new DateTime(2000, m, 1).ToString("MMMM"))</option> }</select>
    </form>
    <div><a asp-action="Index" class="btn btn-link">← Reports</a><a asp-action="Journal" asp-route-year="@year" asp-route-month="@month" asp-route-csv="true" class="btn btn-outline-secondary">Export CSV</a></div>
</div>
<div class="card"><table class="table mb-0"><thead><tr><th>Debit</th><th>Credit</th><th>Cost centre</th><th>Description</th><th class="num">Amount</th></tr></thead><tbody>
@foreach (var r in Model) { <tr><td>@r.DebitAccount</td><td>@r.CreditAccount</td><td>@r.CostCenter</td><td>@r.Description</td><td class="num">@Ui.Money(r.Amount)</td></tr> }
@if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">No depreciation posted for this period.</td></tr> }
</tbody><tfoot><tr class="fw-bold"><td colspan="4">Total</td><td class="num">@Ui.Money(Model.Sum(r => r.Amount))</td></tr></tfoot></table></div>
