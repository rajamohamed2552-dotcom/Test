@model AssetCategory
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var editing = Model.Id != 0;
    ViewData["Title"] = editing ? $"Edit category {Model.Code}" : "New category";
}
<form asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@(editing ? Model.Id : null)" method="post" class="card p-3" style="max-width:860px">
    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
    <div class="row g-3">
        <div class="col-md-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" readonly="@editing" /></div>
        <div class="col-md-5"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="AssetClass" class="form-label"></label><input asp-for="AssetClass" class="form-control" list="classes" /><datalist id="classes"><option>Plant &amp; Machinery</option><option>Tooling</option><option>Vehicles</option><option>IT</option><option>Buildings</option><option>Furniture</option><option>Land</option></datalist></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><input asp-for="Description" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="DefaultMethod" class="form-label"></label><select asp-for="DefaultMethod" class="form-select" asp-items="Html.GetEnumSelectList<DepreciationMethod>()"></select></div>
        <div class="col-md-3"><label asp-for="DefaultUsefulLifeMonths" class="form-label"></label><input asp-for="DefaultUsefulLifeMonths" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="DefaultSalvagePercent" class="form-label"></label><input asp-for="DefaultSalvagePercent" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="CapitalizationThreshold" class="form-label"></label><input asp-for="CapitalizationThreshold" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="AssetGlAccountId" class="form-label">Asset GL</label><select asp-for="AssetGlAccountId" class="form-select" asp-items="(SelectList)ViewBag.AssetGl"><option value="">—</option></select></div>
        <div class="col-md-4"><label asp-for="AccumDepGlAccountId" class="form-label">Accumulated depreciation GL</label><select asp-for="AccumDepGlAccountId" class="form-select" asp-items="(SelectList)ViewBag.AccumGl"><option value="">—</option></select></div>
        <div class="col-md-4"><label asp-for="DepExpenseGlAccountId" class="form-label">Depreciation expense GL</label><select asp-for="DepExpenseGlAccountId" class="form-select" asp-items="(SelectList)ViewBag.ExpGl"><option value="">—</option></select></div>
        <div class="col-12 form-check ms-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label"></label></div>
    </div>
    <div class="mt-3"><button class="btn btn-primary">Save</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div>
</form>
