@model MaintenancePlan
@{ ViewData["Title"] = "New maintenance plan"; var assets = (List<Asset>)ViewBag.AssetList; }
<form asp-action="CreatePlan" method="post" class="card p-3" style="max-width:760px">
    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
    <div class="row g-3">
        <div class="col-12"><label asp-for="AssetId" class="form-label">Asset</label><select asp-for="AssetId" class="form-select"><option value="">Select…</option>
            @foreach (var a in assets) { <option value="@a.Id" selected="@(Model.AssetId == a.Id)">@a.AssetTag · @a.Name</option> }</select></div>
        <div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="FrequencyDays" class="form-label">Frequency (days)</label><input asp-for="FrequencyDays" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="NextDueDate" class="form-label"></label><input asp-for="NextDueDate" type="date" class="form-control" /></div>
        <div class="col-md-6"><label asp-for="EstimatedCost" class="form-label"></label><input asp-for="EstimatedCost" type="number" step="0.01" class="form-control" /></div>
        <div class="col-12"><label asp-for="Instructions" class="form-label"></label><textarea asp-for="Instructions" class="form-control" rows="3"></textarea></div>
    </div>
    <div class="mt-3"><button class="btn btn-primary">Create plan</button> <a asp-action="Plans" class="btn btn-link">Cancel</a></div>
</form>
