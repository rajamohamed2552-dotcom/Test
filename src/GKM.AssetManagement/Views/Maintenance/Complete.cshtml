@model CompleteWorkOrderForm
@using Microsoft.AspNetCore.Mvc.Rendering
@{ ViewData["Title"] = "Complete work order"; var w = (WorkOrder)ViewBag.WorkOrder; }
<p><b>@w.Number</b> · @w.Title · <a asp-controller="Assets" asp-action="Details" asp-route-id="@w.AssetId">@w.Asset?.AssetTag</a></p>
<form asp-action="Complete" method="post" class="card p-3" style="max-width:760px">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="LaborCost" class="form-label"></label><input asp-for="LaborCost" type="number" step="0.01" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="PartsCost" class="form-label"></label><input asp-for="PartsCost" type="number" step="0.01" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="ExternalCost" class="form-label"></label><input asp-for="ExternalCost" type="number" step="0.01" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Condition" class="form-label"></label><select asp-for="Condition" class="form-select" asp-items="Html.GetEnumSelectList<AssetCondition>()"></select></div>
        <div class="col-12"><label asp-for="ResolutionNotes" class="form-label"></label><textarea asp-for="ResolutionNotes" class="form-control" rows="3"></textarea></div>
    </div>
    <div class="mt-3"><button class="btn btn-success">Complete &amp; record cost</button> <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a></div>
</form>
