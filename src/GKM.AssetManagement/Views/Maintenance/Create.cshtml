@model WorkOrderForm
@using Microsoft.AspNetCore.Mvc.Rendering
@{ ViewData["Title"] = "New work order"; var assets = (List<Asset>)ViewBag.AssetList; }
<form asp-action="Create" method="post" class="card p-3" style="max-width:760px">
    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
    <div class="row g-3">
        <div class="col-12"><label asp-for="AssetId" class="form-label">Asset</label><select asp-for="AssetId" class="form-select"><option value="">Select…</option>
            @foreach (var a in assets) { <option value="@a.Id" selected="@(Model.AssetId == a.Id)">@a.AssetTag · @a.Name</option> }</select></div>
        <div class="col-12"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div>
        <div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div>
        <div class="col-md-3"><label asp-for="Type" class="form-label"></label><select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<WorkOrderType>()"></select></div>
        <div class="col-md-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<Priority>()"></select></div>
        <div class="col-md-3"><label asp-for="AssignedTo" class="form-label"></label><input asp-for="AssignedTo" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="ScheduledDate" class="form-label"></label><input asp-for="ScheduledDate" type="date" class="form-control" /></div>
    </div>
    <div class="mt-3"><button class="btn btn-primary">Create work order</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div>
</form>
