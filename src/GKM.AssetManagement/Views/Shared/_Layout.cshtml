<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Home") · GKM Asset Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    string Active(string c) => (ViewContext.RouteData.Values["controller"]?.ToString() ?? "") == c ? "active" : "";
}
@if (!signedIn)
{
    @RenderBody()
}
else
{
    <div class="app-shell">
        <nav class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">GKM</span> Asset Management</a>
            <div class="nav-section">Overview</div>
            <a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a>
            <div class="nav-section">Asset lifecycle</div>
            <a class="nav-link @Active("Classification")" asp-controller="Classification" asp-action="Index">Classification</a>
            <a class="nav-link @Active("Assets")" asp-controller="Assets" asp-action="Index">Asset register</a>
            @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.FinanceManager))
            {
                <a class="nav-link @Active("Onboarding")" asp-controller="Onboarding" asp-action="Index">Onboarding approvals</a>
            }
            <a class="nav-link @Active("Movements")" asp-controller="Movements" asp-action="Index">Tracking &amp; transfers</a>
            <a class="nav-link @Active("Maintenance")" asp-controller="Maintenance" asp-action="Index">Maintenance</a>
            <div class="nav-section">Finance</div>
            @if (!User.IsInRole(Roles.PlantManager) && !User.IsInRole(Roles.MaintenanceEngineer))
            {
                <a class="nav-link @Active("Depreciation")" asp-controller="Depreciation" asp-action="Index">Depreciation</a>
                <a class="nav-link @Active("Reports")" asp-controller="Reports" asp-action="Index">Reports</a>
            }
            @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.FinanceManager))
            {
                <a class="nav-link @Active("Masters")" asp-controller="Masters" asp-action="Index">Master data</a>
            }
            <div class="nav-section">Control</div>
            <a class="nav-link @Active("Audits")" asp-controller="Audits" asp-action="Index">Audits</a>
            <a class="nav-link" asp-controller="Audits" asp-action="Trail">Activity trail</a>
        </nav>
        <div class="main">
            <header class="topbar">
                <div class="fw-semibold">@ViewData["Title"]</div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-flex align-items-center gap-3">
                    <span class="text-muted small">@User.Identity!.Name · @string.Join(", ", Roles.All.Where(User.IsInRole))</span>
                    <button class="btn btn-sm btn-outline-secondary">Sign out</button>
                </form>
            </header>
            <main class="content">
                @if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
                @RenderBody()
            </main>
        </div>
    </div>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
