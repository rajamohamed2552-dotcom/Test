@model List<AssetMovement>
@{ ViewData["Title"] = "Tracking & transfers"; }
<div class="d-flex justify-content-between mb-3">
    <div><a asp-action="Where" class="btn btn-outline-secondary">Where are my assets?</a></div>
    @if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.FinanceManager) || User.IsInRole(Roles.AssetAccountant) || User.IsInRole(Roles.PlantManager))
    {
        <a asp-action="Create" class="btn btn-primary">+ Transfer asset</a>
    }
</div>
<div class="card"><div class="table-responsive"><table class="table table-hover mb-0 align-middle">
    <thead><tr><th>Date</th><th>Asset</th><th>From</th><th>To</th><th>Cost centre</th><th>Custodian</th><th>Reason</th><th>By</th></tr></thead><tbody>
    @foreach (var m in Model)
    {
        <tr><td class="text-nowrap">@m.MovedOn.ToString("dd MMM yyyy")</td>
            <td><a asp-controller="Assets" asp-action="Details" asp-route-id="@m.AssetId">@m.Asset?.AssetTag</a></td>
            <td>@m.FromPlant?.Code / @(m.FromLocation?.Name ?? "—")</td><td>@m.ToPlant?.Code / @(m.ToLocation?.Name ?? "—")</td>
            <td>@m.FromCostCenter?.Code → @m.ToCostCenter?.Code</td><td>@m.FromCustodian → @m.ToCustodian</td><td>@m.Reason</td><td class="text-muted">@m.MovedBy</td></tr>
    }
    @if (Model.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-4">No movements recorded.</td></tr> }
    </tbody></table></div></div>
