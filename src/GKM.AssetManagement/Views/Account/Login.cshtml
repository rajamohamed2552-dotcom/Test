@model LoginViewModel
@{ ViewData["Title"] = "Sign in"; }
<div class="login-wrap">
    <div class="card login-card p-4">
        <h5 class="mb-1">GKM Asset Management</h5>
        <p class="text-muted small">Finance &amp; Cost Management</p>
        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
            <div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autofocus /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" /><span asp-validation-for="Password" class="text-danger small"></span></div>
            <div class="form-check mb-3"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label"></label></div>
            <button class="btn btn-primary w-100">Sign in</button>
        </form>
    </div>
</div>
