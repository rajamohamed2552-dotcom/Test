@model Asset
@{ ViewData["Title"] = $"Dispose {Model.AssetTag}"; }
<div class="card p-3" style="max-width:640px">
    <p><b>@Model.Name</b><br />Cost @Ui.Money(Model.AcquisitionCost) · Accumulated depreciation @Ui.Money(Model.AccumulatedDepreciation) · <b>Book value @Ui.Money(Model.BookValue)</b></p>
    <form asp-action="Dispose" asp-route-id="@Model.Id" method="post">
        <div class="mb-3"><label class="form-label">Disposal date</label><input name="disposalDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div>
        <div class="mb-3"><label class="form-label">Sale / scrap proceeds</label><input name="proceeds" type="number" step="0.01" min="0" class="form-control" value="0" required /><div class="form-text">Gain/loss = proceeds − book value is calculated on submit.</div></div>
        <div class="mb-3"><label class="form-label">Reason</label><input name="reason" class="form-control" maxlength="300" required /></div>
        <button class="btn btn-danger" onclick="return confirm('Disposal is final. Continue?')">Dispose asset</button> <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
    </form>
</div>
