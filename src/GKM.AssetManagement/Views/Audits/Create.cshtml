@model AuditCampaign
@using Microsoft.AspNetCore.Mvc.Rendering
@{ ViewData["Title"] = "New audit campaign"; }
<form asp-action="Create" method="post" class="card p-3" style="max-width:700px">
    <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
    <div class="row g-3">
        <div class="col-12"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" placeholder="e.g. FY26 Annual Physical Verification" /></div>
        <div class="col-md-4"><label asp-for="PlantId" class="form-label">Plant in scope</label><select asp-for="PlantId" class="form-select" asp-items="(SelectList)ViewBag.Plants"></select></div>
        <div class="col-md-4"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" type="date" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" type="date" class="form-control" /></div>
    </div>
    <div class="form-text mt-2">Every active asset at the plant is snapshotted into the campaign with its expected location.</div>
    <div class="mt-3"><button class="btn btn-primary">Create campaign</button> <a asp-action="Index" class="btn btn-link">Cancel</a></div>
</form>
